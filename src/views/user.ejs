<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= username %></title>

  <link rel="stylesheet" href="styles/tokens.css">
  <link rel="stylesheet" href="styles/account.css">
  <link rel="icon" type="image/svg+xml" href="favicon.svg">
  <script src="/socket.io/socket.io.js"></script>
  <script src="js/cookieUtil.js"></script>
  <script src="js/theme.js"></script>
</head>

<body>
  <button id="themeToggle" class="theme-toggle" onclick="toggleTheme()" title="Переключить тему">
    <span id="themeIcon">🌙</span>
  </button>

  <div class="page">
    <header class="brand">
      <nav class="page-nav">
        <a href="/users" class="nav-back">← К списку</a>
        <h1 class="nav-title"><%= username %></h1>
        <span class="nav-spacer"></span>
      </nav>
    </header>

    <div class="account-card">
      <% if (!notFound) { %>    <div class="account-head">
        <div class="account-identity">
          <div class="avatar"><%= username.charAt(0) %></div>
          <div class="account-who">
            <div class="account-name"><%- username %></div>
            <div class="account-elo">Elo: <%- elo %></div>
          </div>
        </div>
        <div class="account-count">Сыграно партий: <%- played %></div>
      </div>
      <% } else { %>    <div class="account-head">
        <div class="account-identity">
          <div class="avatar"><%= username.charAt(0) %></div>
          <div class="account-who">
            <div class="account-name"><%- username %></div>
          </div>
        </div>
        <div class="account-count"><%- msg %></div>
      </div>
      <% } %>

      <!-- T33 (contract 36): public profile — Дата | Соперник | Результат (+ method
           label) from games.csv, newest first; the opponent is the other side of
           the row (a guest shows as '-'). Result is from THIS user's perspective
           (win -> Победа). Client JS is not needed here (server-rendered); D1 may
           restyle later. The raw rows are also available at /api/users/:name/games. -->
      <div class="account-table-wrap">
        <table id="profile-games-table" class="games-table">
          <thead>
            <tr>
              <th>Дата</th>
              <th>Соперник</th>
              <th>Результат</th>
              <th>Метод</th>
            </tr>
          </thead>
          <tbody id="profile-games-body">
            <% (games && games.length ? games : []).forEach(function (g) { %>  <tr>
              <td><%= g.date %></td>
              <td><%= g.opponent %></td>
              <td class="result result-<%= g.result %>"><%= g.result === 'win' ? 'Победа' : (g.result === 'loss' ? 'Поражение' : 'Ничья') %></td>
              <td><%= g.method %></td>
            </tr>
            <% }); %>
            <% if (!games || games.length === 0) { %>  <tr class="empty-row"><td colspan="4"><%- (notFound ? 'Пользователь не найден' : 'Партий пока нет') %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</body>

</html>
