<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Кабинет</title>

  <link rel="stylesheet" href="styles/tokens.css">
  <link rel="stylesheet" href="styles/account.css">
  <link rel="icon" type="image/svg+xml" href="favicon.svg">
  <script src="/socket.io/socket.io.js"></script>
  <script src="js/cookieUtil.js"></script>
  <script src="js/theme.js"></script>
</head>

<body>
  <button id="themeToggle" class="theme-toggle" onclick="toggleTheme()" title="Переключить тему">
    <span id="themeIcon">🌙</span>
  </button>

  <div class="page">
    <header class="brand">
      <nav class="page-nav">
        <a href="/index" class="nav-back">← В лобби</a>
        <h1 class="nav-title">Кабинет</h1>
        <span class="nav-spacer"></span>
      </nav>
    </header>

    <div id="account-card" class="account-card">
      <div class="account-head">
        <div class="account-identity">
          <div class="avatar"><%= username.charAt(0) %></div>
          <div class="account-who">
            <div class="account-name"><%- username %></div>
            <div class="account-elo">Elo: <%- elo %></div>
          </div>
        </div>
        <div class="account-count">Сыграно партий: <%- played %></div>
      </div>

      <% if (!games || games.length === 0) { %>
      <!-- Review fix (design-36): the empty state lives OUTSIDE the horizontally
           scrollable table so it can never clip on 390px screens. -->
      <p class="empty-note">Партий пока нет</p>
      <% } else { %>
      <div class="account-table-wrap">
        <table id="games-table" class="games-table">
          <thead>
            <tr>
              <th>Дата</th>
              <th>Соперник</th>
              <th>Результат</th>
              <th>Elo до</th>
              <th>Elo после</th>
            </tr>
          </thead>
          <tbody id="games-body">
            <% games.forEach(function (g) { %>  <tr>
              <td><%= g.date %></td>
              <td><%= g.opponent %></td>
              <td class="result result-<%= g.result %>"><%= g.result === 'win' ? 'Победа' : (g.result === 'loss' ? 'Поражение' : 'Ничья') %></td>
              <td><%= g.eloBefore %></td>
              <td><%= g.eloAfter %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>
</body>

</html>
