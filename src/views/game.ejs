<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chess</title>

  <link rel="stylesheet" href="styles/game.css">
  <script src="/socket.io/socket.io.js"></script>
  <script>
    let matchId = "<%= matchId %>";
  </script>
</head>

<button id="themeToggle" class="theme-toggle" onclick="toggleTheme()" title="Toggle theme">
  <span id="themeIcon">🌙</span>
</button>

<body>
  <div id="game-container">
    <div id="captured-black" class="captured-row"></div>
    <canvas id="cnv"></canvas>
    <div id="captured-white" class="captured-row"></div>
  </div>
  <h1 id="status">Waiting for player...</h1>

  <!-- Game action buttons -->
  <div id="game-actions" class="game-actions" style="display:none;">
    <button id="btn-takeback" class="game-btn game-btn-info">Takeback</button>
    <button id="btn-offer-draw" class="game-btn game-btn-secondary">Offer Draw</button>
    <button id="btn-challenge" class="game-btn game-btn-warning">Challenge</button>
    <button id="btn-resign" class="game-btn game-btn-danger">Resign</button>
  </div>

  <!-- Resign confirmation modal -->
  <div id="resignModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
      <h3>Resign?</h3>
      <p>Are you sure you want to resign? You will lose the game.</p>
      <div class="modal-actions">
        <button id="btn-resign-cancel" class="modal-btn modal-btn-secondary">Cancel</button>
        <button id="btn-resign-confirm" class="modal-btn modal-btn-danger">Resign</button>
      </div>
    </div>
  </div>

  <!-- Incoming draw offer modal -->
  <div id="drawOfferModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
      <h3>🤝 Draw Offer</h3>
      <p>Your opponent has offered a draw.</p>
      <div class="modal-actions">
        <button id="btn-draw-decline" class="modal-btn modal-btn-secondary">Decline</button>
        <button id="btn-draw-accept" class="modal-btn modal-btn-success">Accept</button>
      </div>
    </div>
  </div>

  <!-- Incoming challenge modal -->
  <div id="challengeModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
      <h3>⚔️ Challenge</h3>
      <p>Your opponent challenges you to resign.</p>
      <div class="modal-actions">
        <button id="btn-challenge-decline" class="modal-btn modal-btn-secondary">Decline</button>
        <button id="btn-challenge-accept" class="modal-btn modal-btn-success">Accept</button>
      </div>
    </div>
  </div>

  <!-- Incoming takeback offer modal -->
  <div id="takebackOfferModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
      <h3>↩️ Takeback Offer</h3>
      <p>Your opponent wants to undo their last move.</p>
      <div class="modal-actions">
        <button id="btn-takeback-decline" class="modal-btn modal-btn-secondary">Decline</button>
        <button id="btn-takeback-accept" class="modal-btn modal-btn-success">Accept</button>
      </div>
    </div>
  </div>

  <!-- Game end modal -->
  <div id="gameEndModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
      <h3 id="gameEndTitle"></h3>
      <p id="gameEndText"></p>
      <div class="modal-actions">
        <button onclick="document.getElementById('gameEndModal').style.display='none'; window.location.href='/index'" class="modal-btn modal-btn-primary">Back to Lobby</button>
      </div>
    </div>
  </div>
  <script src="js/chessutils.js"></script>
  <script src="js/theme.js"></script>
  <script src="js/game.js"></script>
  <script src="js/gameSockets.js"></script>

  <!-- Promotion selector modal -->
  <div id="promotionModal" class="promotion-modal" style="display:none;">
    <div class="promotion-content">
      <h3>Choose a piece</h3>
      <div id="promotionChoices" class="promotion-choices"></div>
    </div>
  </div>

  <!-- Repetition warning modal -->
  <div id="repetitionWarningModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000;">
    <div style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); background:#1a1a2e; padding:30px; border-radius:12px; max-width:400px; text-align:center;">
      <h3 style="color:#ffcc00;">⚠️ Внимание</h3>
      <p id="repetitionWarningText" style="color:#ccc;"></p>
      <button onclick="document.getElementById('repetitionWarningModal').style.display='none'" style="margin-top:15px; padding:10px 30px; background:#333; color:#fff; border:none; border-radius:6px; cursor:pointer;">OK</button>
    </div>
  </div>
</body>

</html>