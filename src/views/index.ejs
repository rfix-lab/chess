<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Шахматы</title>

  <link rel="stylesheet" href="styles/index.css">
  <link rel="icon" type="image/svg+xml" href="favicon.svg">
  <script src="/socket.io/socket.io.js"></script>
  <script src="js/events.js"></script>
</head>

<body>
  <header class="brand">
    <h1>♞ Шахматы</h1>
    <p>Войдите или сразу сыграйте</p>
  </header>

  <!-- Big action stack (contract 32): [Вход]/[Играть] >= 56px, [Регистрация] ~40px.
       Private-link generation is GONE from the lobby — the GAME page owns it now. -->
  <div id="action-stack" class="action-stack">
    <button id="login-button" class="big-btn">Вход</button>
    <button id="play-button" class="big-btn">Играть</button>
    <button id="register-button" class="mid-btn">Регистрация</button>
  </div>

  <!-- Login / registration form (revealed by [Вход] or [Регистрация]). -->
  <div id="form" class="auth-card hide">
    <h2 id="form-title">Вход</h2>
    <div class="field">
      <label for="username">Имя пользователя</label>
      <input type="text" name="username" id="username" list="username-list" autocomplete="off">
      <datalist id="username-list"></datalist>
    </div>
    <div class="field">
      <label for="password">Пароль</label>
      <input type="password" name="password" id="password">
    </div>
    <div class="actions">
      <button class="btn-primary" id="submit-auth" onclick="submitAuth()">Войти</button>
    </div>
  </div>

  <!-- Invites (rendered from the server 'invites' event; contract 32 §3).
       Each row: who invited, their Elo, method, [Принять] -> /game?matchId=. -->
  <div id="invites" class="invites hide">
    <h2>Приглашения</h2>
    <div id="invites-list"></div>
  </div>

  <!-- Authenticated controls — visible when the sessionID cookie is present. -->
  <div id="authed" class="authed hide">
    <a href="/account" id="account-link" class="account-link">Кабинет</a>
    <button id="logout-button" class="logout-btn" onclick="doLogout()">Выйти</button>
  </div>

  <div id="auth-success" class="auth-note hide"></div>
  <div id="auth-fail" class="auth-note hide">
    <h3>Неверный логин или пароль.</h3>
  </div>
  <div id="signup-fail" class="auth-note hide">
    <h3 id="signup-fail-usrnmexists" class="hide">Не удалось! Имя уже занято.</h3>
    <h3 id="signup-fail-pswdlen" class="hide">Не удалось! Введите непустой пароль.</h3>
    <h3 id="signup-fail-pswdinvalid" class="hide">Не удалось! Имя: 3–32 символа — буквы, цифры, точка, подчёркивание, дефис.</h3>
  </div>

  <script src="js/cookieUtil.js"></script>
  <script src="js/index.js"></script>
  <script src="js/indexSockets.js"></script>
</body>

</html>
