<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Шахматы</title>

  <link rel="stylesheet" href="styles/tokens.css">
  <link rel="stylesheet" href="styles/index.css">
  <link rel="icon" type="image/svg+xml" href="favicon.svg">
  <script src="/socket.io/socket.io.js"></script>
  <script src="js/events.js"></script>
</head>

<body>
  <div class="lobby-shell">
  <header class="brand">
    <h1>♞ Шахматы</h1>
    <p>Войдите или сразу сыграйте</p>
  </header>

  <!-- Big action stack (contract 32): [Вход]/[Играть] >= 56px, [Регистрация] ~40px.
       Contract 36: [Пользователи] added to the stack -> /users directory.
       F4 (contract 38): ONE aligned stack in both states — the #authed wrapper
       (Кабинет/Выйти) is nested INSIDE the stack as a transparent flex child, so
       a logged-in user sees exactly [Играть][Пользователи][Кабинет][Выйти] with
       identical widths/heights/gaps; a guest sees [Играть][Пользователи][Вход]
       [Регистрация] (Кабинет/Выйти hidden). [Вход]/[Регистрация] are HIDDEN while
       logged in (indexSockets.js reflects the /api/me state on load and on
       signin/logout). -->
  <div id="action-stack" class="action-stack">
    <button id="play-button" class="big-btn">Играть</button>
    <button id="users-button" class="big-btn">Пользователи</button>
    <!-- Authenticated controls (Кабинет/Выйти) now part of the stack (F4);
         #authed remains the JS/E2E hook indexSockets.js toggles. -->
    <div id="authed" class="authed hide">
      <a href="/account" id="account-link" class="account-link">Кабинет</a>
      <button id="logout-button" class="logout-btn" onclick="doLogout()">Выйти</button>
    </div>
    <button id="login-button" class="big-btn">Вход</button>
    <button id="register-button" class="mid-btn">Регистрация</button>
  </div>

  <!-- Login / registration form (revealed by [Вход] or [Регистрация]).
       F4b (contract 38): this card doubles as the mobile modal — one field
       per row, label above its input, all full-width, dark autofill; fits the
       viewport and scrolls internally above 90vh. #form is the JS/E2E hook
       (indexSockets toggles its .hide/.show); the visible, scrollable card is
       the inner .auth-scroll, which carries the card chrome so the shadow
       never clips at the page edge. The same markup serves both Вход and
       Регистрация; indexSockets only rewrites #form-title and the submit
       label. -->
  <div id="form" class="auth-card hide">
    <div class="auth-scroll">
      <h2 id="form-title">Вход</h2>
      <div class="field">
        <label for="username">Имя пользователя</label>
        <input type="text" name="username" id="username" list="username-list" autocomplete="off">
        <datalist id="username-list"></datalist>
      </div>
      <div class="field">
        <label for="password">Пароль</label>
        <input type="password" name="password" id="password">
      </div>
      <div class="actions">
        <button class="btn-primary" id="submit-auth" onclick="submitAuth()">Войти</button>
      </div>
    </div><!-- /.auth-scroll -->
  </div>

  <!-- Invites (rendered from the server 'invites' event; contract 32 §3).
       Each row: who invited, their Elo, method, [Принять] -> /game?matchId=. -->
  <div id="invites" class="invites hide">
    <h2>Приглашения</h2>
    <div id="invites-list"></div>
  </div>

  <div id="auth-success" class="auth-note hide"></div>
  <div id="auth-fail" class="auth-note hide">
    <h3>Неверный логин или пароль</h3>
  </div>
  <div id="signup-fail" class="auth-note hide">
    <h3 id="signup-fail-usrnmexists" class="hide">Имя уже занято</h3>
    <h3 id="signup-fail-pswdlen" class="hide">Введите непустой пароль</h3>
    <h3 id="signup-fail-pswdinvalid" class="hide">Имя: 3–32 символа — буквы, цифры, точка, подчёркивание, дефис</h3>
  </div>
  </div><!-- /.lobby-shell -->

  <script src="js/cookieUtil.js"></script>
  <!-- Integration fix (contract 36): index.js defines the global `play` used by
       wireBigButtons() in indexSockets.js — it must load FIRST. -->
  <script src="js/index.js"></script>
  <script src="js/indexSockets.js"></script>
</body>

</html>
