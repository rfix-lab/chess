<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chess Lobby</title>

  <link rel="stylesheet" href="styles/index.css">
  <script src="/socket.io/socket.io.js"></script>
  <script src="js/events.js"></script>
</head>

<body>
  <header class="brand">
    <h1>♞ Chess</h1>
    <p>Sign in or jump straight into a game</p>
  </header>

  <div id="form">
    <div class="field">
      <label for="username">Username</label>
      <input type="text" name="username" id="username" list="username-list" autocomplete="off">
      <datalist id="username-list"></datalist>
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input type="password" name="password" id="password">
    </div>
    <div class="actions">
      <button class="btn-primary" onclick="submitLoginDetails()">Sign In</button>
      <button class="btn-secondary" onclick="submitSignUpDetails()">Sign Up</button>
    </div>
  </div>

  <div class="guest">
    <button onclick="play()" id="play-button" class="btn-primary">Play as Guest</button>
    <button onclick="genLink()" id="play-button" class="btn-secondary">Generate play link</button>
    <a href="" id="generated-link" class="hide"></a>
  </div>

  <div id="auth-success" class="auth-note hide"></div>
  <div id="auth-fail" class="auth-note hide">
    <h3>Invalid credentials.</h3>
  </div>
  <div id="signup-fail" class="auth-note hide">
    <h3 id="signup-fail-usrnmexists" class="hide">Failed! User name already exists.</h3>
    <h3 id="signup-fail-pswdlen" class="hide">Failed! Enter a non empty password.</h3>
    <h3 id="signup-fail-pswdinvalid" class="hide">Failed! Username must be 3-32 characters: letters, digits, dot, underscore, dash.</h3>
  </div>

  <script src="js/cookieUtil.js"></script>
  <script src="js/index.js"></script>
  <script src="js/indexSockets.js"></script>
</body>

</html>
